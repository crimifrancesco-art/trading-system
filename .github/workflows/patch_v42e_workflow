name: Patch v42e Workflow

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v5

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: '3.13'

      - name: Verify source files
        run: |
          ls -lah
          test -f Dashboard_pro_V_41d.py
          test -f patch_v42e.py

      - name: Run patch_v42e.py
        run: |
          python -u patch_v42e.py 2>&1
          test -f Dashboard_pro_V_42e.py

      - name: Commit generated file
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add patch_v42e.py Dashboard_pro_V_42e.py .github/workflows/patch_v42e_workflow.yml
          git diff --cached --quiet && echo "No changes to commit" || git commit -m "Add Dashboard_pro_V_42e via patch workflow"
          git push
